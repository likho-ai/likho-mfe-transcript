{
  "name": "likho-mfe-transcript",
  "version": "0.1.0",
  "description": "Likho transcript app: the player, both text layers, live lines and versions; loaded by likho-web-shell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5175 --strictPort",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@likho-ai/ui": "https://github.com/likho-ai/likho-ui/releases/download/v0.1.0/likho-ai-ui-0.1.0.tgz",
    "@likho-ai/web-sdk": "https://github.com/likho-ai/likho-web-sdk/releases/download/v0.8.0/likho-ai-web-sdk-0.8.0.tgz",
    "@tanstack/react-query": "^5.104.1",
    "graphql": "^16.11.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "wavesurfer.js": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@module-federation/vite": "^1.23.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "postcss-prefix-selector": "^2.2.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
